[{"rule":"当日亏损","level":"严重","threshold":5,"unit":"%","description":"最近一个完整日的官方盈亏为亏损，且亏损额超过前一日资金的这个比例","key":"day_loss_pct"},{"rule":"持仓浮亏","level":"严重","threshold":5,"unit":"%","description":"快照时所有持仓的浮动亏损合计超过当前资金的这个比例","key":"upnl_loss_pct"},{"rule":"接近强平","level":"严重","threshold":15,"unit":"%","description":"任一持仓的标记价距离强平价不足这个比例","key":"liq_distance_pct"},{"rule":"盈亏回撤","level":"警告","threshold":10,"unit":"%","description":"本期累计官方盈亏从最高点回落的金额超过当前资金的这个比例","key":"drawdown_pct"},{"rule":"累计亏损","level":"警告","threshold":5,"unit":"%","description":"2026-10-01 以来累计官方亏损超过投入资金（当前资金 − 本期盈亏）的这个比例","key":"period_loss_pct"},{"rule":"杠杆过高","level":"警告","threshold":3,"unit":" 倍","description":"持仓名义价值合计 ÷ 当前资金 超过这个倍数","key":"leverage_max"},{"rule":"大额流出","level":"提示","threshold":20,"unit":"%","description":"最近一个完整日净流出（出金、转出、存入金库）超过前一日资金的这个比例","key":"outflow_pct"},{"rule":"停止交易","level":"提示","threshold":3,"unit":" 天","description":"曾经交易过的地址连续这么多天没有成交","key":"idle_days"},{"rule":"小额账户豁免","level":"—","threshold":1000,"unit":" USD","description":"资金低于这个金额的地址不做以上百分比类检查，避免小额账户误报","key":"min_equity"}]